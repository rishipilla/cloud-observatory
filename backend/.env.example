# SQLite is the default for local development. PostgreSQL can be used by setting
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/cloud_observatory
DATABASE_URL=sqlite:///./cloud_observatory.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-check HTTP timeouts.
CHECK_CONNECT_TIMEOUT_SECONDS=3
CHECK_TOTAL_TIMEOUT_SECONDS=8
CHECK_MAX_REDIRECTS=5

# Optional provider credentials. These are read only by the backend and are
# never returned by the API. Replace blank values in your local backend/.env.
# AWS IAM user/role credentials: restrict permissions to the required services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Google Cloud service-account JSON file path (do not paste JSON credentials here).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare account API credentials. Public status API needs no token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional generic API placeholder; requires a provider-specific adapter to call.
EXTERNAL_API_KEY=
EXTERNAL_API_BASE_URL=
